@*
    =====================================================================
    LISTA DE CURSOS - visao do professor e do admin.

    O professor enxerga cursos ATIVOS E INATIVOS, por isso o controller usa
    LocalizarCurso em vez de BuscarCurso. O aluno, no catalogo, so ve
    os ativos.

    O botao "Excluir" nao apaga nada direto: leva para a pagina de
    confirmacao do DS10, que lista o que sera apagado e pede a senha do
    professor.
    =====================================================================
*@
@model List<Curso>
@{
    ViewData["Title"] = "Cursos";

    string afr_termo = ViewBag.Termo as string ?? "";
}

<h1>Cursos e aulas</h1>
<p class="subtitulo">
    Cadastre os cursos, defina o requisito de conclusão e monte as aulas
    de cada um.
</p>

<section class="cartao" aria-label="Buscar cursos">
    <form role="search" asp-controller="Cursos" asp-action="Index" method="get">
        <div class="filtros">
            <div class="campo campo-largo">
                <label for="termo">Buscar curso</label>
                <input type="search" id="termo" name="termo" value="@afr_termo"
                       placeholder="Título ou descrição" />
            </div>

            <button type="submit" class="botao">Buscar</button>

            <a asp-controller="Cursos" asp-action="Novo" class="botao botao-primario">
                Novo curso
            </a>
        </div>
    </form>
</section>

@if (Model.Count == 0)
{
    <div class="cartao vazio">
        <p>Nenhum curso encontrado.</p>
    </div>
}
else
{
    <section class="cartao" style="padding:0; overflow-x:auto;" aria-label="Lista de cursos">
        <table>
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Título</th>
                    <th>Carga</th>
                    <th>Aulas</th>
                    <th>Professor</th>
                    <th>Situação</th>
                    <th class="coluna-acoes">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Curso afr_curso in Model)
                {
                    <tr>
                        <td>@afr_curso.afr_Id</td>
                        <td><strong>@afr_curso.afr_Titulo</strong></td>
                        <td>@afr_curso.afr_CargaHoraria h</td>
                        <td>@afr_curso.afr_TotalAulas</td>

                        @* Professor do curso; sem professor fica em destaque *@
                        <td>
                            @if (afr_curso.afr_ProfessorId == null)
                            {
                                <span class="etiqueta etiqueta-inativo">Sem professor</span>
                            }
                            else
                            {
                                @afr_curso.ObterNomeProfessor()
                            }
                        </td>

                        <td>
                            @if (afr_curso.afr_Ativo)
                            {
                                <span class="etiqueta etiqueta-ativo">Ativo</span>
                            }
                            else
                            {
                                <span class="etiqueta etiqueta-inativo">Inativo</span>
                            }
                        </td>
                        <td class="coluna-acoes">
                            <div class="acoes-linha" style="justify-content:flex-end;">
                                <a class="botao botao-pequeno"
                                   asp-controller="Cursos" asp-action="Aulas"
                                   asp-route-id="@afr_curso.afr_Id">Aulas</a>

                                <a class="botao botao-pequeno"
                                   asp-controller="Cursos" asp-action="Editar"
                                   asp-route-id="@afr_curso.afr_Id">Editar</a>

                                @* DS10 - solicitarExclusao(curso) *@
                                <a class="botao botao-perigo botao-pequeno"
                                   asp-controller="Cursos" asp-action="ConfirmarExclusao"
                                   asp-route-id="@afr_curso.afr_Id">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <p class="ajuda">
        @Model.Count curso(s). Dados da @ViewBag.StatusBanco
    </p>

    <p class="ajuda">
        A coluna <strong>Professor</strong> mostra quem cuida do curso. Quando
        um professor é excluído, o curso continua e aparece como
        <strong>Sem professor</strong> até o administrador escolher outro em Editar.
    </p>

    <p class="ajuda">
        A exclusão acontece em duas etapas (DS10): a próxima página mostra
        quantas aulas e quantos alunos serão afetados e pede a sua senha.
    </p>
}
