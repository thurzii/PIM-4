@*
    =====================================================================
    DC07 (Criar) e DC09 / DS09 (Editar) - o MESMO formulario serve para
    os dois: Id zero significa novo, Id maior que zero significa edicao.
    E a mesma ideia do afr_idSelecionado do FrmCursos no desktop.

    PROFESSOR DO CURSO: o curso fica ligado a quem o criou. O admin
    escolhe (ou troca) o professor; quando um professor e excluido, o
    curso continua e aparece como "Sem professor" ate o admin escolher
    outro.
    =====================================================================
*@
@model CursoViewModel
@{
    bool afr_edicao = Model.EhEdicao();
    ViewData["Title"] = afr_edicao ? "Editar curso" : "Novo curso";
}

<p class="subtitulo" style="margin-bottom:6px;">
    <a asp-controller="Cursos" asp-action="Index">&larr; Voltar para a lista</a>
</p>

<h1>@(afr_edicao ? "Editar curso" : "Novo curso")</h1>

<p class="subtitulo">
    @if (afr_edicao)
    {
        <text>Salvar envia as alterações do curso Id @Model.afr_Id para a API.</text>

        if (ViewBag.TotalAulas != null)
        {
            <text>&middot; @ViewBag.TotalAulas aula(s) cadastrada(s)</text>
        }
    }
    else
    {
        <text>Salvar cadastra o curso pela API.</text>
    }
</p>

<section class="cartao" style="max-width:640px;" aria-label="Dados do curso">
    <form asp-controller="Cursos" asp-action="Salvar" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="afr_Id" />

        <div class="campo">
            <label asp-for="afr_Titulo">Título</label>
            <input asp-for="afr_Titulo" type="text" maxlength="120" />
            <span asp-validation-for="afr_Titulo" class="erro-validacao"></span>
        </div>

        <div class="campo">
            <label asp-for="afr_Descricao">Descrição</label>
            <textarea asp-for="afr_Descricao" maxlength="500"></textarea>
            <span asp-validation-for="afr_Descricao" class="erro-validacao"></span>
        </div>

        <div class="filtros">
            <div class="campo campo-estreito">
                <label asp-for="afr_CargaHoraria">Carga (horas)</label>
                <input asp-for="afr_CargaHoraria" type="number" min="1" max="1000" />
            </div>

            @* Travado em 100%: a API conclui o curso com todas as aulas *@
            <div class="campo campo-estreito">
                <label for="afr_minimo">Mínimo (%)</label>
                <input id="afr_minimo" type="number" value="100" disabled />
            </div>

            @if (ViewBag.EhAdmin == true)
            {
                <div class="campo">
                    <label asp-for="afr_ProfessorId">Professor</label>
                    <select asp-for="afr_ProfessorId">
                        <option value="">(Sem professor)</option>
                        @foreach (Usuario afr_professor in (List<Usuario>)ViewBag.Professores)
                        {
                            <option value="@afr_professor.afr_Id">@afr_professor.afr_Nome</option>
                        }
                    </select>
                </div>
            }
        </div>

        <span asp-validation-for="afr_CargaHoraria" class="erro-validacao"></span>

        @if (ViewBag.EhAdmin == true)
        {
            <div class="ajuda" style="margin-top:8px;">
                <strong>Professor:</strong> quem cuida do curso e das aulas. Se o
                professor for excluído, o curso continua e fica sem professor até
                você escolher outro aqui.
            </div>
        }
        else
        {
            <div class="ajuda" style="margin-top:8px;">
                Você será o professor responsável por este curso.
            </div>
        }

        <div class="campo campo-inline" style="margin-top:16px;">
            <input asp-for="afr_Ativo" type="checkbox" />
            <label asp-for="afr_Ativo">Curso ativo (visível para o aluno)</label>
        </div>

        <div class="acoes">
            <button type="submit" class="botao botao-primario">
                @(afr_edicao ? "Salvar alterações" : "Cadastrar curso")
            </button>

            <a asp-controller="Cursos" asp-action="Index" class="botao">Cancelar</a>

            @if (afr_edicao)
            {
                <a asp-controller="Cursos" asp-action="Aulas" asp-route-id="@Model.afr_Id"
                   class="botao">Aulas deste curso</a>
            }
        </div>
    </form>
</section>
