@*
    =====================================================================
    DC02 / DS02 - Recuperacao de senha em TRES ETAPAS.

    O diagrama DS02 tem quatro linhas de vida: Aluno, TelaRecuperacao,
    Sistema e EMAIL. E a linha "Email", com a mensagem
    enviarCodigo(email), que obriga as tres etapas:

        1) informar o email      -> solicitarRecuperacao / enviarCodigo
        2) conferir o codigo     -> conferirCodigo
        3) escolher a nova senha -> recuperacaoConcluida

    UMA PAGINA, TRES FORMULARIOS. O campo afr_Etapa do ViewModel diz
    qual mostrar. Os dados das etapas anteriores viajam em campos
    escondidos (hidden), e o codigo e conferido DE NOVO no servidor na
    etapa 3: ninguem pula a etapa 2 mandando o formulario na mao.
    =====================================================================
*@
@model RecuperarSenhaViewModel
@{
    ViewData["Title"] = "Recuperar senha";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recuperar senha - Plataforma de Cursos</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<main class="tela-acesso">
    <section class="caixa-acesso">

        <header>
            <h1 class="marca-grande">Recuperar senha</h1>
            <p class="marca-sub">Plataforma de Cursos</p>
        </header>

        <div class="cartao">
        @if (ViewBag.Erro != null) { <p class="aviso aviso-erro">@ViewBag.Erro</p> }
        @if (ViewBag.NovoCodigo != null) {
            <p class="aviso aviso-sucesso">Senha redefinida. Guarde o novo codigo: <strong>@ViewBag.NovoCodigo</strong></p>
        } else {
            <p class="ajuda">Use o codigo pessoal recebido no cadastro.</p>
            <form asp-controller="Conta" asp-action="RedefinirSenha" method="post">
                @Html.AntiForgeryToken()
                <div class="campo"><label>Email</label><input asp-for="afr_Email" type="email" required /></div>
                <div class="campo"><label>Codigo pessoal</label><input asp-for="afr_Codigo" maxlength="19" required /></div>
                <div class="campo"><label>Nova senha</label><input asp-for="afr_NovaSenha" type="password" minlength="8" maxlength="128" required /></div>
                <div class="campo"><label>Confirmar senha</label><input asp-for="afr_Confirmacao" type="password" required /></div>
                <button class="botao botao-primario botao-largo" type="submit">Redefinir senha</button>
            </form>
        }
            <p class="ajuda" style="margin-top:14px;">
                <a asp-controller="Conta" asp-action="Login">Voltar para o login</a>
            </p>
        </div>

    </section>
</main>

</body>
</html>
