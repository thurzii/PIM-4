@{ Layout = null; }
<!DOCTYPE html><html lang="pt-br"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="stylesheet" href="~/css/site.css"/></head><body><main class="tela-acesso"><section class="caixa-acesso"><h1>Criar conta de aluno</h1><div class="cartao">
@if (ViewBag.Erro != null) { <p class="aviso aviso-erro">@ViewBag.Erro</p> }
@if (ViewBag.Codigo != null) { <p>Guarde seu código de recuperação em local seguro. Ele será exibido apenas agora.</p><strong>@ViewBag.Codigo</strong> }
else {
<form method="post" asp-action="Cadastro">@Html.AntiForgeryToken()
<div class="campo"><label for="nome">Nome</label><input id="nome" name="nome" type="text" required /></div>
<div class="campo"><label for="email">Email</label><input id="email" name="email" type="email" required /></div>
<div class="campo"><label for="senha">Senha</label><input id="senha" name="senha" type="password" required /></div>
<div class="campo"><label for="confirmarSenha">Confirmar senha</label><input id="confirmarSenha" name="confirmarSenha" type="password" required /></div>
<button class="botao botao-primario botao-largo" type="submit">Confirmar</button></form> }
<p><a asp-action="Login">Voltar ao login</a></p></div></section></main></body></html>