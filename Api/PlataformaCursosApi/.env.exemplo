# =====================================================================
# MODELO do arquivo .env da API
#
# Copie este arquivo para ".env" (na mesma pasta) e preencha. O .env
# real NAO vai para o GitHub (esta no .gitignore): ele tem a senha do
# banco do Azure.
#
# Os nomes sao os mesmos do .env da API do Gui, de proposito: o mesmo
# arquivo que ele mandou serve aqui sem mudar nada.
# =====================================================================

# Porta em que a API atende (http://localhost:PORTA)
PORT=3000

# Chave que assina os tokens de login. Tem que ser a MESMA da API do
# Gui: com ela igual, um token emitido por uma API vale na outra.
# Precisa ter pelo menos 32 caracteres.
JWT_SECRET=

# SQL Server do Azure (o banco que a Maria criou)
DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_INSTANCE=
