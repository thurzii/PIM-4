<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlataformaCursosApi</RootNamespace>
    <AssemblyName>PlataformaCursosApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- O mesmo driver de SQL Server do desktop e da web -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />

    <!-- scrypt, igual ao SenhaHash dos outros dois projetos: o .NET nao
         traz scrypt e a API do Gui grava as senhas nesse formato -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />

    <!-- Gera e confere o token JWT (o mesmo formato da API do Gui) -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.5.1" />
  </ItemGroup>

  <!-- O .env (com a senha do Azure) fica so na maquina de quem roda. Ele
       e copiado para a pasta de saida para o programa achar mesmo quando
       o Visual Studio roda de dentro de bin/. -->
  <ItemGroup>
    <None Update=".env" CopyToOutputDirectory="PreserveNewest" Condition="Exists('.env')" />
  </ItemGroup>

</Project>
